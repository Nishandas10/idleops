rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write only their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read and write their own VM status data
    match /vmStatus/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Allow users to read and write their own VMware data
    match /vmware/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read and write their own project data
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Allow users to read and write their own instances data
    match /instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Deny access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}